BOT_TOKEN=your-telegram-bot-token-from-botfather
BACKEND_URL=http://localhost:3000
# Telegram chat id (assistant's personal chat, or a staff group) that receives
# urgent "needs a call" notifications. Get it by messaging @userinfobot.
STAFF_CHAT_ID=

# Public HTTPS URL where telegram-app/ is deployed. Telegram Mini Apps only
# work over HTTPS on a publicly reachable domain — localhost will NOT work
# from within the real Telegram app. Leave empty to hide the Mini App button
# and keep only the classic inline-keyboard flow.
WEBAPP_URL=
