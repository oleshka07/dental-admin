DATABASE_URL="postgresql://dental:dental@localhost:5432/dental_admin?schema=public"
PORT=3000

# Comma-separated allowed origins for browser CORS. Leave empty in local dev
# (defaults to allow-all). In production, since site/admin/Mini App are all
# served from the same domain via nginx, this only needs that one domain —
# it's not what makes the API private, just tidy defense in depth.
CORS_ORIGIN=https://galactic.swipescape.eu

# Optional: without this, the AI assistant endpoint falls back to a
# rule-based FAQ responder (still fully functional, just not conversational).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Required for the Telegram Mini App (telegram-app/): must be the EXACT same
# token as telegram-bot/.env's BOT_TOKEN — the backend verifies Mini App
# requests by re-computing the HMAC signature Telegram signs with this token.
TELEGRAM_BOT_TOKEN=
